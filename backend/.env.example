DATABASE_URL=postgresql://wsj:CHANGE_ME@localhost:5437/wsj?schema=public
POSTGRES_USER=wsj
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=wsj
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_12_PLUS_CHARACTER_PASSWORD
PORT=4000
FRONTEND_URL=http://localhost:3000
API_ORIGIN=http://localhost:4000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
INQUIRY_TO=
# Internal payment/refund alerts. Set explicitly in each environment.
FINANCE_NOTIFICATION_EMAIL=

# Optional comma-separated explicit browser origins. No wildcards.
FRONTEND_URLS=

# Stripe payments. See PAYMENTS_SETUP.md for full setup.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Customer accounts (see CUSTOMER_ACCOUNT_IMPLEMENTATION_REPORT.md).
# Transactional email (account setup, sign-in links, receipts) is delivered from the
# EmailOutbox through SMTP_* above. Without SMTP the outbox keeps messages PENDING
# and nothing is reported as sent.
# Local development only: write outgoing mail to files in this directory instead
# of the network. Ignored when NODE_ENV=production.
MAIL_CAPTURE_DIR=
# Set to "off" to disable the in-process outbox worker (e.g. on all but one instance).
OUTBOX_WORKER=

# Cloudflare R2 object storage (src/storage.ts). Values live only in the real .env.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional when R2_ACCOUNT_ID is set: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public base URL for objects (r2.dev development URL or a custom domain), no trailing slash
R2_PUBLIC_URL=
R2_REGION=auto
# Optional: where customer replies to automated emails go (e.g. grow@workspacejunction.com).
REPLY_TO_EMAIL=

# Email marketing: maximum marketing emails per minute (keep within your mail provider's limits; Gmail allows ~500/day).
MARKETING_RATE_PER_MINUTE=20
# Set to off to stop the campaign sender in this process.
MARKETING_WORKER=on
# Optional public API base used in tracking links (defaults to the first FRONTEND_URL + /api).
PUBLIC_API_URL=

# Optional browser Web Push (in-app notifications work without these).
# Generate a pair locally with backend npm exec -- web-push generate-vapid-keys.
# Keep the private key server-only; the public key is returned by the authenticated API.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# WEB_PUSH_DELIVERY=off  # Keep in-app notifications; suppress sends (also disabled in tests).

# Kisi door access. Server-only; never use NEXT_PUBLIC_ for this key.
KISI_API_KEY=
# Opt in after migrating and mapping packages in Admin > Door access.
KISI_ENABLED=false

# Keep the original working Kisi organization read-only.
KISI_LIVE_WRITES=false
# Optional server-only path to a reviewed private reference snapshot.
WORKSPACE_CLONE_REFERENCE_PATH=

# Read-only live monitor for Kisi + Google Sheet (CSV export of a link-shared sheet).
WORKSPACE_LIVE_MONITOR=false
WORKSPACE_LIVE_INTERVAL_SECONDS=60
WORKSPACE_SHEET_ID=

# n8n -> app event webhook (POST /api/integrations/n8n/events). 24+ random characters.
N8N_WEBHOOK_SECRET=
