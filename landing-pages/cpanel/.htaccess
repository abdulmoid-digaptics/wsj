# Workspace Junction - Thanksgiving landing pages (/thanks-giving/)
# Own rewrite rules: the parent WordPress rules are not inherited by this folder.
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /thanks-giving/404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /thanks-giving/

# Private code, config and order log are never served.
RewriteRule ^private(/|$) - [F,L]

# API -> PHP router
RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,END]

# Old .html links -> clean URLs (301)
RewriteCond %{THE_REQUEST} \s/thanks-giving/index\.html[\s?]
RewriteRule ^ /thanks-giving/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/thanks-giving/([a-z0-9-]+)\.html[\s?]
RewriteRule ^ /thanks-giving/%1 [R=301,L]

# Clean URLs -> page files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z0-9-]+)/?$ $1.html [END]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self \"https://js.stripe.com\" \"https://checkout.stripe.com\")"
<FilesMatch "\.html$">
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://js.stripe.com https://*.js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.stripe.com; connect-src 'self' https://api.stripe.com https://*.stripe.com; frame-src https://js.stripe.com https://*.js.stripe.com https://checkout.stripe.com https://*.stripe.com; form-action 'self' mailto:; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<FilesMatch "\.(md|jsonl|log|sql|gz|zip)$">
Require all denied
</FilesMatch>
