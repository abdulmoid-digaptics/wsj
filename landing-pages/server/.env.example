# Copy to server/.env and fill in. Never commit the real .env.

NODE_ENV=production
HOST=127.0.0.1
PORT=4310

# Public address of the landing pages, no trailing slash. Must be https in production.
# Stripe sends buyers back to PUBLIC_URL/checkout-complete.html after payment.
PUBLIC_URL=https://wp.workspacejunction.com/offers
# Set when nginx forwards /offers/... without stripping the prefix (leave empty if it strips it).
BASE_PATH=
# Behind nginx: trust X-Forwarded-For for rate limiting.
TRUST_PROXY=1
# Extra origins allowed to start checkout (comma separated). PUBLIC_URL's origin is always allowed.
ALLOWED_ORIGINS=

# Stripe (Dashboard > Developers > API keys). Use the same account as the main site.
# sk_test_/pk_test_ for testing, sk_live_/pk_live_ for real charges. Both must be the same mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Dashboard > Developers > Webhooks > endpoint PUBLIC_URL/api/webhooks/stripe > Signing secret.
STRIPE_WEBHOOK_SECRET=

# Promo caps ("first 10 desks", "first 50 mailboxes"). Paid orders count automatically.
DESK_PROMO_LIMIT=10
MAILBOX_PROMO_LIMIT=50
# Spots already claimed offline before launch (added to the live count).
DESK_CLAIMED_BASE=0
MAILBOX_CLAIMED_BASE=0

# Where the order log (orders.jsonl) is stored. Back this folder up.
DATA_DIR=./data

# Email (same SMTP account as the main Workspace Junction backend).
# Gmail: smtp.gmail.com, port 465, and a 16-character App Password (not the normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Workspace Junction <you@example.com>
# Team inbox for order and enquiry notifications (comma separated).
NOTIFY_EMAIL=nabeel@digaptics.com
# TESTING ONLY: send every email (including customer confirmations) to these inboxes (comma separated). Empty in production.
MAIL_REDIRECT_TO=
# Customer confirmation emails (false = team contacts customers manually).
CUSTOMER_EMAILS=false