{
  "name": "wsj",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js app components lib",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "dev:api": "npm --prefix backend run start:dev",
    "build:api": "npm --prefix backend run build",
    "db:up": "docker compose --env-file backend/.env up -d postgres",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "test:content": "node --import ./backend/node_modules/tsx/dist/loader.mjs --test scripts/qa/frontend-safety.test.ts",
    "test:api": "npm --prefix backend test",
    "test:api:scenarios": "node scripts/qa/api-scenarios.cjs",
    "test:api:scenario-guards": "node --test scripts/qa/api-scenarios.test.cjs",
    "test:api:scenario-safety": "node -r ./scripts/qa/ts-register.cjs scripts/qa/api-scenarios-safety.test.cjs",
    "test:pricing-catalog": "node -r ./scripts/qa/ts-register.cjs backend/test/pricing-catalog.test.ts",
    "test:stripe-webhook": "node -r ./scripts/qa/ts-register.cjs backend/test/stripe-webhook.test.ts",
    "test:payment-safety": "node scripts/qa/payment-audit-safety.test.cjs",
    "test:api:inputs": "node scripts/qa/api-input-vectors.cjs",
    "test:api:input-guards": "node --test scripts/qa/api-input-vectors.test.cjs",
    "test:local:guards": "node --preserve-symlinks --preserve-symlinks-main scripts/qa/local-audit-launcher.cjs pure",
    "test:layout": "node scripts/qa/layout-audit.cjs",
    "test:public": "node scripts/qa/public-functional.cjs",
    "test:browser": "node scripts/qa/browser-smoke.cjs",
    "test:assets": "node scripts/qa/assets-smoke.cjs",
    "test:lighthouse": "node scripts/qa/lighthouse.mjs",
    "test:settings": "node scripts/qa/business-settings.cjs",
    "test:redirects": "node scripts/qa/redirects.cjs",
    "images:hero": "node scripts/generate-hero-images.cjs",
    "test:performance-baseline": "node scripts/qa/performance-baseline.mjs",
    "test:performance-guards": "node --test scripts/qa/performance-baseline-guards.test.cjs",
    "test:paint-timeline": "node --test scripts/qa/paint-timeline.test.mjs",
    "test:service-content": "node --import ./backend/node_modules/tsx/dist/loader.mjs --test scripts/qa/service-content.test.ts",
    "test:redesign-ui": "node --import ./backend/node_modules/tsx/dist/loader.mjs scripts/qa/redesign-ui.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@studio-freight/lenis": "^1.0.42",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dom-serializer": "3.1.1",
    "domutils": "4.0.2",
    "gsap": "^3.15.0",
    "htmlparser2": "12.0.0",
    "lucide-react": "^1.62.0",
    "matter-js": "^0.20.0",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "sanitize-html": "^2.18.1",
    "scroll-smooth": "^1.1.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "lighthouse": "^13.6.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
